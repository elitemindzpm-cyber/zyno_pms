  mobile_number             String?   @db.Text
  email_address             String?   @db.Text
  permanent_address         String?   @db.Text
  local_address             String?   @db.Text
  emergency_contact_name    String?   @db.Text
  emergency_contact_phone   String?   @db.Text
  employer_name             String?   @db.Text
  employer_address          String?   @db.Text
  designation               String?   @db.Text
  monthly_income            Decimal?  @db.Decimal(18, 4)
  authorized_signatory_name String?   @db.Text
  authorized_signatory_id   String?   @db.Text
