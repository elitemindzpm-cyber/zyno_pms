generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model amenities {
  id                 String               @id @db.VarChar(255)
  label              String               @db.Text
  icon               String?              @db.VarChar(255)
  property_amenities property_amenities[]
}

model assets {
  id                               String                   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  asset_code                       String?                  @unique @db.VarChar(255)
  asset_name                       String                   @db.Text
  category                         String?                  @db.VarChar(255)
  subcategory                      String?                  @db.Text
  brand                            String?                  @db.Text
  model                            String?                  @db.Text
  serial_number                    String?                  @db.Text
  ownership_type                   String?                  @db.Text
  purchase_date                    DateTime?                @db.Date
  supplier                         String?                  @db.Text
  purchase_cost                    Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  warranty_expiry_date             DateTime?                @db.Date
  warranty_status                  String?                  @db.Text
  department_id                    String?                  @db.VarChar(36)
  assigned_property_id             String?                  @db.VarChar(36)
  assigned_unit_id                 String?                  @db.VarChar(36)
  assigned_employee_id             String?                  @db.VarChar(36)
  assignment_date                  DateTime?                @db.Date
  asset_condition                  String?                  @db.Text
  asset_status                     String?                  @default("Available") @db.Text
  life_of_asset                    Int?
  opening_cost                     Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  last_service_date                DateTime?                @db.Date
  next_service_date                DateTime?                @db.Date
  remarks                          String?                  @db.Text
  created_at                       DateTime?                @default(now()) @db.DateTime(6)
  updated_at                       DateTime?                @default(now()) @db.DateTime(6)
  assigned_property_code           String?                  @db.Text
  assigned_unit_code               String?                  @db.Text
  assigned_employee_name           String?                  @db.Text
  addition_during_year             Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  total_asset_value                Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  disposal_value                   Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  opening_accumulated_depreciation Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  current_year_depreciation        Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  closing_accumulated_depreciation Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  net_book_value                   Decimal?                 @default(0.0000) @db.Decimal(18, 4)
  return_date                      DateTime?                @db.Date
  disposal_date                    DateTime?                @db.Date
  department                       String?                  @db.Text
  depreciation_method              String?                  @db.Text
  depreciation_rate                Decimal?                 @db.Decimal(18, 4)
  employees                        employees?               @relation(fields: [assigned_employee_id], references: [id], onUpdate: Restrict)
  properties                       properties?              @relation(fields: [assigned_property_id], references: [id], onUpdate: Restrict)
  units                            units?                   @relation(fields: [assigned_unit_id], references: [id], onUpdate: Restrict)
  departments                      departments?             @relation(fields: [department_id], references: [id], onUpdate: Restrict)
  hrms_asset_allocations           hrms_asset_allocations[]

  @@index([assigned_employee_id], map: "assets_assigned_employee_id_fkey")
  @@index([assigned_property_id], map: "assets_assigned_property_id_fkey")
  @@index([assigned_unit_id], map: "assets_assigned_unit_id_fkey")
  @@index([department_id], map: "assets_department_id_fkey")
  salvage_value Decimal? @default(0.0000) @db.Decimal(18, 4)
}

model bookings {
  id           String      @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  property_id  String?     @db.VarChar(36)
  guest_id     String?     @db.VarChar(36)
  check_in     DateTime    @db.Date
  check_out    DateTime    @db.Date
  guests_count Int
  total_price  Decimal     @db.Decimal(18, 4)
  status       String?     @default("PENDING") @db.VarChar(255)
  created_at   DateTime?   @default(now()) @db.DateTime(6)
  updated_at   DateTime?   @default(now()) @db.DateTime(6)
  profiles     profiles?   @relation(fields: [guest_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  properties   properties? @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  reviews      reviews[]

  @@index([guest_id], map: "bookings_guest_id_fkey")
  @@index([property_id], map: "bookings_property_id_fkey")
}

model coa_classes {
  id         String     @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  group_id   String     @db.VarChar(36)
  type_id    String     @db.VarChar(36)
  group_code String     @db.Text
  type_code  String     @db.Text
  code       String     @unique @db.VarChar(255)
  name       String     @db.VarChar(255)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.DateTime(6)
  updated_at DateTime   @default(now()) @db.DateTime(6)
  coa_groups coa_groups @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_types  coa_types  @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_gl     coa_gl[]
  coa_sl     coa_sl[]

  @@index([group_id], map: "coa_classes_group_id_fkey")
  @@index([type_id], map: "coa_classes_type_id_fkey")
}

model coa_gl {
  id                        String      @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  class_id                  String      @db.VarChar(36)
  group_id                  String      @db.VarChar(36)
  type_id                   String      @db.VarChar(36)
  class_code                String      @db.Text
  group_code                String      @db.Text
  type_code                 String      @db.Text
  code                      String      @unique @db.VarChar(255)
  name                      String      @db.VarChar(255)
  normal_balance            String      @db.Text
  is_control_account        Boolean     @default(false)
  is_posting_account        Boolean     @default(true)
  allows_direct_posting     Boolean     @default(true)
  requires_property         Boolean     @default(false)
  requires_unit             Boolean     @default(false)
  requires_tenant           Boolean     @default(false)
  requires_vendor           Boolean     @default(false)
  requires_employee         Boolean     @default(false)
  requires_asset            Boolean     @default(false)
  requires_inventory        Boolean     @default(false)
  requires_security_deposit Boolean     @default(false)
  requires_pdc              Boolean     @default(false)
  requires_lease            Boolean     @default(false)
  is_active                 Boolean     @default(true)
  created_at                DateTime    @default(now()) @db.DateTime(6)
  updated_at                DateTime    @default(now()) @db.DateTime(6)
  coa_classes               coa_classes @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_groups                coa_groups  @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_types                 coa_types   @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_sl                    coa_sl[]

  @@index([class_id], map: "coa_gl_class_id_fkey")
  @@index([group_id], map: "coa_gl_group_id_fkey")
  @@index([type_id], map: "coa_gl_type_id_fkey")
}

model coa_groups {
  id          String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  type_id     String        @db.VarChar(36)
  type_code   String        @db.Text
  code        String        @unique @db.VarChar(255)
  name        String        @db.VarChar(255)
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.DateTime(6)
  updated_at  DateTime      @default(now()) @db.DateTime(6)
  coa_classes coa_classes[]
  coa_gl      coa_gl[]
  coa_types   coa_types     @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_sl      coa_sl[]

  @@index([type_id], map: "coa_groups_type_id_fkey")
}

model coa_sl {
  id                                                         String             @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  gl_id                                                      String             @db.VarChar(36)
  class_id                                                   String             @db.VarChar(36)
  group_id                                                   String             @db.VarChar(36)
  type_id                                                    String             @db.VarChar(36)
  gl_code                                                    String             @db.Text
  class_code                                                 String             @db.Text
  group_code                                                 String             @db.Text
  type_code                                                  String             @db.Text
  code                                                       String             @unique @db.VarChar(255)
  name                                                       String             @db.VarChar(255)
  normal_balance                                             String             @db.Text
  is_control_account                                         Boolean            @default(false)
  is_posting_account                                         Boolean            @default(true)
  allows_direct_posting                                      Boolean            @default(true)
  requires_property                                          Boolean            @default(false)
  requires_unit                                              Boolean            @default(false)
  requires_tenant                                            Boolean            @default(false)
  requires_vendor                                            Boolean            @default(false)
  requires_employee                                          Boolean            @default(false)
  requires_asset                                             Boolean            @default(false)
  requires_inventory                                         Boolean            @default(false)
  requires_security_deposit                                  Boolean            @default(false)
  requires_pdc                                               Boolean            @default(false)
  requires_lease                                             Boolean            @default(false)
  is_active                                                  Boolean            @default(true)
  created_at                                                 DateTime           @default(now()) @db.DateTime(6)
  updated_at                                                 DateTime           @default(now()) @db.DateTime(6)
  coa_classes                                                coa_classes        @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_gl                                                     coa_gl             @relation(fields: [gl_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_groups                                                 coa_groups         @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  coa_types                                                  coa_types          @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: Restrict)
  unit_coa_mapping_unit_coa_mapping_deposit_sl_idTocoa_sl    unit_coa_mapping[] @relation("unit_coa_mapping_deposit_sl_idTocoa_sl")
  unit_coa_mapping_unit_coa_mapping_pdc_sl_idTocoa_sl        unit_coa_mapping[] @relation("unit_coa_mapping_pdc_sl_idTocoa_sl")
  unit_coa_mapping_unit_coa_mapping_receivable_sl_idTocoa_sl unit_coa_mapping[] @relation("unit_coa_mapping_receivable_sl_idTocoa_sl")

  @@index([class_id], map: "coa_sl_class_id_fkey")
  @@index([gl_id], map: "coa_sl_gl_id_fkey")
  @@index([group_id], map: "coa_sl_group_id_fkey")
  @@index([type_id], map: "coa_sl_type_id_fkey")
}

model coa_types {
  id             String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  code           String        @unique @db.VarChar(255)
  name           String        @db.VarChar(255)
  normal_balance String        @db.Text
  report_type    String        @db.Text
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now()) @db.DateTime(6)
  updated_at     DateTime      @default(now()) @db.DateTime(6)
  coa_classes    coa_classes[]
  coa_gl         coa_gl[]
  coa_groups     coa_groups[]
  coa_sl         coa_sl[]
}

model collection_receipts {
  id                        String                @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  lease_collection_id       String?               @db.VarChar(36)
  lease_id                  String?               @db.VarChar(36)
  receipt_no                String                @unique @db.VarChar(255)
  receipt_date              DateTime              @default(dbgenerated("(curdate())")) @db.Date
  tenant_name               String                @db.Text
  property_unit             String                @db.Text
  payment_type              String                @db.Text
  payment_method            String                @db.Text
  transaction_reference     String?               @db.Text
  amount                    Decimal?              @db.Decimal(18, 4)
  collection_period         String?               @db.Text
  cashier_name              String?               @db.Text
  print_count               Int                   @default(0)
  emailed_at                DateTime?             @db.DateTime(6)
  shared_at                 DateTime?             @db.DateTime(6)
  created_at                DateTime              @default(now()) @db.DateTime(6)
  original_receipt_id       String?               @db.VarChar(36)
  version                   Int?                  @default(1)
  cancellation_reason       String?               @db.Text
  status                    String?               @default("active") @db.VarChar(255)
  collection_receipts       collection_receipts?  @relation("collection_receiptsTocollection_receipts", fields: [original_receipt_id], references: [id], onUpdate: Restrict)
  other_collection_receipts collection_receipts[] @relation("collection_receiptsTocollection_receipts")

  @@index([original_receipt_id], map: "collection_receipts_original_receipt_id_fkey")
}

