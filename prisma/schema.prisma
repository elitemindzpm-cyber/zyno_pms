  primary_mobile            String?   @db.Text
  primary_email             String?   @db.Text
  current_address           String?   @db.Text
  preferred_communication   String?   @db.Text
  customer_status           String?   @default("Active") @db.Text
  remarks                   String?   @db.Text
  first_name                String?   @db.Text
  middle_name               String?   @db.Text
  last_name                 String?   @db.Text
  qid_expiry_date           DateTime? @db.Date
  passport_expiry_date      DateTime? @db.Date
  date_of_birth             DateTime? @db.Date
  gender                    String?   @db.Text
  company_legal_name        String?   @db.Text
  trade_name                String?   @db.Text
  cr_expiry_date            DateTime? @db.Date
  trade_licence_no          String?   @db.Text
  trade_licence_expiry_date DateTime? @db.Date
  computer_card_no          String?   @db.Text
  computer_card_expiry_date DateTime? @db.Date
  tax_identification_no     String?   @db.Text
  registered_office_address String?   @db.Text
  billing_address           String?   @db.Text
  company_telephone         String?   @db.Text
  website                   String?   @db.Text
  industry_activity         String?   @db.Text
  signatory_qid_passport    String?   @db.Text
  signatory_id_expiry_date  DateTime? @db.Date
  primary_contact_person    String?   @db.Text
  contact_designation       String?   @db.Text
  contact_mobile            String?   @db.Text
  contact_email             String?   @db.Text
  users                     users?    @relation(fields: [verified_by], references: [id], onUpdate: Restrict)
  leases                    leases[]

  @@index([verified_by], map: "customers_verified_by_fkey")
}

model departments {
  id                     String                   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name                   String                   @unique @db.VarChar(255)
  description            String?                  @db.Text
  created_at             DateTime?                @default(now()) @db.DateTime(6)
  updated_at             DateTime?                @default(now()) @db.DateTime(6)
  code                   String?                  @db.VarChar(255)
  company_id             String?                  @db.VarChar(36)
  business_unit_id       String?                  @db.VarChar(36)
  department_head_id     String?                  @db.VarChar(36)
  is_active              Boolean?                 @default(true)
  assets                 assets[]
  hrms_business_units    hrms_business_units?     @relation(fields: [business_unit_id], references: [id], onUpdate: Restrict)
  hrms_companies         hrms_companies?          @relation(fields: [company_id], references: [id], onUpdate: Restrict)
  designations           designations[]
  employees              employees[]
  hrms_announcements     hrms_announcements[]
  hrms_kpa_templates     hrms_kpa_templates[]
  hrms_sub_departments   hrms_sub_departments[]
  proc_purchase_orders   proc_purchase_orders[]
  proc_purchase_requests proc_purchase_requests[]

  @@index([business_unit_id], map: "departments_business_unit_id_fkey")
  @@index([company_id], map: "departments_company_id_fkey")
}

model designations {
  id                 String               @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  title              String               @unique @db.VarChar(255)
  department_id      String?              @db.VarChar(36)
  level              Int?                 @default(1)
  created_at         DateTime?            @default(now()) @db.DateTime(6)
  updated_at         DateTime?            @default(now()) @db.DateTime(6)
  code               String?              @db.VarChar(255)
  grade_id           String?              @db.VarChar(36)
  job_level          Int?                 @default(1)
  is_active          Boolean?             @default(true)
  departments        departments?         @relation(fields: [department_id], references: [id], onUpdate: Restrict)
  hrms_grades        hrms_grades?         @relation(fields: [grade_id], references: [id], onUpdate: Restrict)
  employees          employees[]
  hrms_kpa_templates hrms_kpa_templates[]

  @@index([department_id], map: "designations_department_id_fkey")
  @@index([grade_id], map: "designations_grade_id_fkey")
}

