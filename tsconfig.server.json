{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "outDir": "./dist/server"
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "src"]
}

